numbers = [4, 8, 15, 16, 23, 42]

# stats(nums) returns min, max, average as a tuple
def stats(nums):
    lo = min(nums)
    hi = max(nums)
    avg = sum(nums) / len(nums)
    return (lo, hi, avg)  

# Unpack into lo, hi, avg
lo, hi, avg = stats(numbers)
print(lo, hi, avg)

#  grade(marks, passing=50)
def grade(marks, passing=50):
    if marks >= passing:
        return "Pass"
    else:
        return "Fail"

# Calls
print(grade(55), grade(55, passing=60))